    "homepage": "https://espressio.org",
    "authors": {"name":"Simon J. Stuart","maintainer":true,"url":"https://espressio.org"},
    "repository": {"type":"git","url":"https://github.com/ESPressio-Development-Platform/ESPressio-WiFi.git"},
    "license": "Apache-2.0",
